# Database Configuration
DB_ROOT_PASSWORD=password
DB_HOST=db
DB_PORT=3306
DB_NAME=corrector_despa
DB_USER=corrector
DB_PASSWORD=corrector123

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434

# Modelo a usar. Ejemplos:
#   phi3 / phi4          → modelo de texto (requiere Tesseract para OCR)
#   gemma3:27b           → modelo multimodal (no requiere Tesseract)
OLLAMA_MODEL=phi3

# true  → pipeline multimodal: las imágenes se envían directamente al modelo (ej. gemma3)
# false → pipeline de texto: se usa Tesseract/OCR antes de enviar al modelo (ej. phi3/phi4)
OLLAMA_MULTIMODAL=false

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Corrector de Documentos

# Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Timezone Configuration
TIMEZONE=America/Argentina/Buenos_Aires
